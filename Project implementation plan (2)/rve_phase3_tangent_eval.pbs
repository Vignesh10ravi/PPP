#!/bin/bash
#PBS -N rve_tangent_eval
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=8GB
#PBS -l walltime=08:00:00
#PBS -o /scratch/vr80beqo/rve_phase3_900_seed2718/data/training_cpu_5000/tangent/tangent.out
#PBS -e /scratch/vr80beqo/rve_phase3_900_seed2718/data/training_cpu_5000/tangent/tangent.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source /scratch/vr80beqo/venvs/ppp-rve-train-cpu/bin/activate

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4

RUN_DIR=/scratch/vr80beqo/rve_phase3_900_seed2718
OUT_DIR="$RUN_DIR/data/training_cpu_5000/tangent"

python -u -m benchmarks.rve_surrogate_tangent_evaluation \
  --dataset "$RUN_DIR/data/rve_phase3_900.npz" \
  --manifest "$RUN_DIR/data/rve_phase3_900.manifest.json" \
  --checkpoint "$RUN_DIR/data/training_cpu_5000/partial_icnn_900sample.pt" \
  --report "$OUT_DIR/tangent_report.json" \
  --csv "$OUT_DIR/tangent_predictions.csv" \
  --device cpu \
  --torch-threads 4 \
  2>&1 | tee "$OUT_DIR/tangent.log"
