#!/bin/bash
#PBS -N rve_phase7_eval
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=06:00:00
#PBS -o /scratch/vr80beqo/rve_phase7_independent_evaluation.out
#PBS -e /scratch/vr80beqo/rve_phase7_independent_evaluation.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$SCRATCH/venvs/ppp-rve-train-cpu/bin/activate"

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4

PHASE6=/scratch/vr80beqo/rve_phase6_targeted_20261106
PHASE7=/scratch/vr80beqo/rve_phase7_independent_20261107
TRAIN_DIR="$PHASE6/data/training_objective_tangent"
DATASET="$PHASE7/data/rve_phase7_independent.npz"
MANIFEST="$PHASE7/data/rve_phase7_independent.manifest.json"
CHECKPOINT="$TRAIN_DIR/partial_icnn_phase6_targeted.pt"
TRAINING_DATASET="$PHASE6/data/rve_phase6_targeted.npz"
OUT_DIR="$PHASE7/evaluation"
mkdir -p "$OUT_DIR"

python -c 'import numpy, torch; print("NumPy", numpy.__version__, "PyTorch", torch.__version__)'
python -u -m benchmarks.rve_test_set_evaluation \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --report "$OUT_DIR/energy_stress_report.json" \
  --csv "$OUT_DIR/energy_stress_predictions.csv" \
  --device cpu \
  --torch-threads 4 \
  --allow-independent-dataset \
  --exclude-state-index 0 \
  2>&1 | tee "$OUT_DIR/energy_stress_evaluation.log"

python -u -m benchmarks.rve_surrogate_tangent_evaluation \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --training-dataset "$TRAINING_DATASET" \
  --report "$OUT_DIR/tangent_report.json" \
  --csv "$OUT_DIR/tangent_predictions.csv" \
  --device cpu \
  --torch-threads 4 \
  --split test \
  --allow-independent-dataset \
  --exclude-state-index 0 \
  2>&1 | tee "$OUT_DIR/tangent_evaluation.log"

python -u -m benchmarks.rve_surrogate_constitutive_checks \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --training-dataset "$TRAINING_DATASET" \
  --report "$OUT_DIR/constitutive_checks.json" \
  --states-per-det-bin 2 \
  --fd-step 1.0e-5 \
  --torch-threads 4 \
  2>&1 | tee "$OUT_DIR/constitutive_checks.log"
