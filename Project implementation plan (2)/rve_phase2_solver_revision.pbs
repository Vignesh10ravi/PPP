#!/bin/bash
#PBS -N rve_phase2
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=96GB
#PBS -l walltime=08:00:00
#PBS -o /scratch/vr80beqo/rve_phase2_solver_revision_oR3pd5/data/rve_phase2_resume.out
#PBS -e /scratch/vr80beqo/rve_phase2_solver_revision_oR3pd5/data/rve_phase2_resume.err

set -o pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load openmpi/gcc/11.4.0/4.1.6
module load python/gcc/11.4.0/3.11.7
source "$HOME/venvs/ppp-ngsolve/bin/activate"

python -c 'import numpy, ngsolve; print("NumPy and NGSolve imports OK", ngsolve.__version__)'

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

python -u -m src.generate_rve_dataset_parallel \
  --output /scratch/vr80beqo/rve_phase2_solver_revision_oR3pd5/data/rve_phase2.npz \
  --work-directory /scratch/vr80beqo/rve_phase2_solver_revision_oR3pd5/data/rve_phase2_work \
  --volume-fractions 0.02 0.05 0.10 \
  --n-deformations 100 \
  --seed 1729 \
  --max-strain 0.20 \
  --determinant-floor 0.50 \
  --max-condition-number 3.0 \
  --maxh 0.22 \
  --mu 1.0 \
  --bulk-modulus 10000 \
  --displacement-order 2 \
  --integration-order 10 \
  --workers 4 \
  2>&1 | tee /scratch/vr80beqo/rve_phase2_solver_revision_oR3pd5/data/rve_phase2_resume.log
