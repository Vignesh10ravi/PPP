#!/bin/bash
#PBS -N rve_convergence
#PBS -q teachingq
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -l walltime=08:00:00
#PBS -o /scratch/vr80beqo/rve_phase2_convergence.out
#PBS -e /scratch/vr80beqo/rve_phase2_convergence.err

set -o pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load openmpi/gcc/11.4.0/4.1.6
module load python/gcc/11.4.0/3.11.7
source "$HOME/venvs/ppp-ngsolve/bin/activate"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

python -u -m benchmarks.rve_convergence \
  --output /scratch/vr80beqo/rve_phase2_convergence.json \
  2>&1 | tee -a /scratch/vr80beqo/rve_phase2_convergence.log
