#!/bin/bash
#PBS -N rve_iso_check
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -l walltime=08:00:00
#PBS -o /scratch/vr80beqo/rve_phase2_microscopic_j_maxit200_20261101/data/material_isotropy_check/isotropy.out
#PBS -e /scratch/vr80beqo/rve_phase2_microscopic_j_maxit200_20261101/data/material_isotropy_check/isotropy.err

set -o pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load openmpi/gcc/11.4.0/4.1.6
module load python/gcc/11.4.0/3.11.7
source "$HOME/venvs/ppp-ngsolve/bin/activate"

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

RUN_DIR=/scratch/vr80beqo/rve_phase2_microscopic_j_maxit200_20261101
CHECK_DIR="$RUN_DIR/data/material_isotropy_check"

python -u -m benchmarks.rve_material_isotropy_check \
  --dataset "$RUN_DIR/data/rve_phase2_microj.npz" \
  --manifest "$RUN_DIR/data/rve_phase2_microj.manifest.json" \
  --output "$CHECK_DIR/isotropy_report.json" \
  2>&1 | tee "$CHECK_DIR/isotropy.log"
