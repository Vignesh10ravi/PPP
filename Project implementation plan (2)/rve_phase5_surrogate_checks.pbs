#!/bin/bash
#PBS -N rve_phase5_surrcheck
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=06:00:00
#PBS -o /scratch/vr80beqo/rve_phase5_surrogate_checks.out
#PBS -e /scratch/vr80beqo/rve_phase5_surrogate_checks.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$SCRATCH/venvs/ppp-rve-train-cpu/bin/activate"

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4

BASE_ROOT=/scratch/vr80beqo/rve_phase4_compression_20261103
EVAL_ROOT=/scratch/vr80beqo/rve_phase5_independent_eval_20261104
OUT_DIR="$EVAL_ROOT/evaluation/constitutive_checks"
mkdir -p "$OUT_DIR"

python -c 'import numpy, torch; print("NumPy", numpy.__version__, "PyTorch", torch.__version__)'
python -u -m benchmarks.rve_surrogate_constitutive_checks \
  --dataset "$EVAL_ROOT/data/rve_phase5_independent.npz" \
  --manifest "$EVAL_ROOT/data/rve_phase5_independent.manifest.json" \
  --checkpoint "$BASE_ROOT/data/training_phase4_tangentloss/partial_icnn_phase4_tangent.pt" \
  --training-dataset "$BASE_ROOT/data/rve_phase4_compression.npz" \
  --report "$OUT_DIR/constitutive_checks.json" \
  --states-per-det-bin 2 \
  --fd-step 1.0e-5 \
  --torch-threads 4 \
  2>&1 | tee "$OUT_DIR/constitutive_checks.log"
