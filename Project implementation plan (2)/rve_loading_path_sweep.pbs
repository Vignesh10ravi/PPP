#!/bin/bash
#PBS -N rve_load_paths
#PBS -q teachingq
#PBS -l select=1:ncpus=1:mem=8GB
#PBS -l walltime=02:00:00
#PBS -o /scratch/vr80beqo/rve_loading_path_sweep.out
#PBS -e /scratch/vr80beqo/rve_loading_path_sweep.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$HOME/venvs/ppp-ngsolve/bin/activate"

export TORCH_NUM_THREADS=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1

CHECKPOINT=/scratch4/vr80beqo/rve_phase7_augmented_finetune12/training/partial_icnn_phase6_phase7_finetuned.pt
OUT_DIR=/scratch/vr80beqo/rve_loading_path_sweep_20261114
mkdir -p "$OUT_DIR"

test -f "$CHECKPOINT"
python -u -m benchmarks.rve_loading_path_sweep \
  --checkpoint "$CHECKPOINT" \
  --expected-checkpoint-sha256 32b0a41fdd75f7610a2147c053c013998f8cd6cb1032ea3e8c7d1b045c0fea70 \
  --volume-fractions 0.02 0.05 0.10 \
  --max-amplitude 0.10 \
  --steps 11 \
  --fd-step 1.0e-5 \
  --derivative-tolerance 1.0e-5 \
  --tangent-symmetry-tolerance 1.0e-8 \
  --minimum-determinant 0.50 \
  --maximum-determinant 1.80 \
  --max-condition-number 3.0 \
  --torch-threads 1 \
  --output "$OUT_DIR/rve_loading_path_sweep.json" \
  --csv "$OUT_DIR/rve_loading_path_sweep.csv" \
  2>&1 | tee "$OUT_DIR/run.log"
