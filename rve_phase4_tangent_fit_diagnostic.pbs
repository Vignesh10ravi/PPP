#!/bin/bash
#PBS -N rve_phase4_tangent_fit
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=08:00:00
#PBS -o /scratch/vr80beqo/rve_phase4_compression_20261103/rve_phase4_tangent_fit.out
#PBS -e /scratch/vr80beqo/rve_phase4_compression_20261103/rve_phase4_tangent_fit.err

set -o pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$SCRATCH/venvs/ppp-rve-train-cpu/bin/activate"

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4

RUN_ROOT=/scratch/vr80beqo/rve_phase4_compression_20261103
TRAIN_DIR="$RUN_ROOT/data/training_phase4"
DIAG_DIR="$TRAIN_DIR/tangent/fit_diagnostics"
mkdir -p "$DIAG_DIR"

for SPLIT in train validation; do
  python -u -m benchmarks.rve_surrogate_tangent_evaluation \
    --dataset "$RUN_ROOT/data/rve_phase4_compression.npz" \
    --manifest "$RUN_ROOT/data/rve_phase4_compression.manifest.json" \
    --checkpoint "$TRAIN_DIR/partial_icnn_phase4.pt" \
    --report "$DIAG_DIR/${SPLIT}_tangent_report.json" \
    --csv "$DIAG_DIR/${SPLIT}_tangent_predictions.csv" \
    --device cpu \
    --torch-threads 4 \
    --split "$SPLIT" \
    2>&1 | tee "$DIAG_DIR/${SPLIT}_tangent_evaluation.log"
done
