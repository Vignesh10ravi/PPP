"""Evaluate a trained pICNN on the held-out RVE test split.

This is a post-training diagnostic. It reports normalized and physical
energy/stress errors overall and by volume fraction, without using the test
split to update model parameters.
"""

import argparse
import csv
import hashlib
import json
import os
from pathlib import Path

import numpy as np
import torch
from torch.func import jacrev, vmap

from src.picnn import HyperelasticNN


def _sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _atomic_json(path, payload):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(
        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)


def _error_metrics(energy_error, stress_error, sample_ids, energy_scale, stress_scale):
    energy_error = np.asarray(energy_error, dtype=float).reshape(-1)
    stress_error = np.asarray(stress_error, dtype=float)
    energy_scaled = energy_error / energy_scale
    stress_scaled = stress_error / stress_scale
    stress_per_sample = np.sqrt(np.mean(stress_scaled**2, axis=(1, 2)))
    worst_energy = int(np.argmax(np.abs(energy_scaled)))
    worst_stress = int(np.argmax(stress_per_sample))
    return {
        "n_samples": int(len(sample_ids)),
        "energy_rmse": float(np.sqrt(np.mean(energy_error**2))),
        "energy_mae": float(np.mean(np.abs(energy_error))),
        "energy_nrmse_train_scale": float(np.sqrt(np.mean(energy_scaled**2))),
        "energy_nmae_train_scale": float(np.mean(np.abs(energy_scaled))),
        "energy_max_abs_error_train_scale": float(np.max(np.abs(energy_scaled))),
        "worst_energy_sample_id": str(sample_ids[worst_energy]),
        "stress_component_rmse": float(np.sqrt(np.mean(stress_error**2))),
        "stress_component_mae": float(np.mean(np.abs(stress_error))),
        "stress_nrmse_train_scale": float(np.sqrt(np.mean(stress_scaled**2))),
        "stress_nmae_train_scale": float(np.mean(np.abs(stress_scaled))),
        "stress_max_abs_component_error_train_scale": float(
            np.max(np.abs(stress_scaled))
        ),
        "worst_stress_sample_id": str(sample_ids[worst_stress]),
    }


def evaluate_test_set(
    dataset_path,
    manifest_path,
    checkpoint_path,
    report_path,
    csv_path,
    device="cpu",
    torch_threads=1,
    allow_independent_dataset=False,
):
    dataset_path = Path(dataset_path)
    manifest_path = Path(manifest_path)
    checkpoint_path = Path(checkpoint_path)
    dataset_sha256 = _sha256_file(dataset_path)
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    checkpoint = torch.load(checkpoint_path, map_location=device, weights_only=True)

    if manifest.get("dataset_sha256") != dataset_sha256:
        raise ValueError("dataset hash does not match its manifest")
    training_dataset_sha256 = checkpoint.get("dataset_sha256")
    dataset_is_independent = training_dataset_sha256 != dataset_sha256
    if dataset_is_independent and not allow_independent_dataset:
        raise ValueError("checkpoint was trained on a different dataset")

    required = {
        "sample_id",
        "split",
        "state_index",
        "volume_fraction",
        "deformation_gradient",
        "energy",
        "stress",
    }
    with np.load(dataset_path, allow_pickle=False) as archive:
        missing = required.difference(archive.files)
        if missing:
            raise ValueError(f"dataset is missing fields: {sorted(missing)}")
        data = {name: np.array(archive[name]) for name in required}

    sample_ids = data["sample_id"].astype(str)
    splits = data["split"].astype(str)
    test_indices = np.flatnonzero(splits == "test")
    if len(test_indices) == 0:
        raise ValueError("dataset has no held-out test samples")

    F_np = np.asarray(data["deformation_gradient"], dtype=float)
    vf_np = np.asarray(data["volume_fraction"], dtype=float)
    energy_np = np.asarray(data["energy"], dtype=float).reshape(-1)
    stress_np = np.asarray(data["stress"], dtype=float)
    if F_np.shape != (len(sample_ids), 3, 3):
        raise ValueError("deformation_gradient must have shape (N, 3, 3)")
    if stress_np.shape != (len(sample_ids), 3, 3):
        raise ValueError("stress must have shape (N, 3, 3)")
    if not all(np.all(np.isfinite(x)) for x in (F_np, vf_np, energy_np, stress_np)):
        raise ValueError("dataset contains nonfinite values")

    torch.set_num_threads(int(torch_threads))
    torch.set_num_interop_threads(1)
    device = torch.device(device)
    dtype = torch.float64
    model = HyperelasticNN(n_ctx=1).to(device=device, dtype=dtype)
    model.load_state_dict(checkpoint["state_dict"])
    model.eval()

    test_ids = sample_ids[test_indices]
    test_vf = vf_np[test_indices]
    F_test = torch.as_tensor(F_np[test_indices], dtype=dtype, device=device)
    vf_test = torch.as_tensor(
        vf_np[test_indices].reshape(-1, 1), dtype=dtype, device=device
    )

    predicted_energy = torch.empty(len(test_indices), dtype=dtype, device=device)
    predicted_stress = torch.empty(
        (len(test_indices), 3, 3), dtype=dtype, device=device
    )
    with torch.enable_grad():
        for vf_value in torch.unique(vf_test[:, 0]):
            local_indices = torch.nonzero(
                vf_test[:, 0] == vf_value, as_tuple=False
            ).flatten()
            local_F = F_test.index_select(0, local_indices)
            local_context = vf_test.index_select(0, local_indices)
            reference_context = local_context[:1]
            reference = model.reference(dtype, device, reference_context)
            local_energy = model.energy(
                local_F, local_context, ref=reference
            ).reshape(-1)

            def energy_single(gradient):
                return model.energy(
                    gradient.unsqueeze(0),
                    reference_context,
                    ref=reference,
                ).squeeze()

            local_stress = vmap(jacrev(energy_single))(local_F)
            predicted_energy = predicted_energy.index_copy(
                0, local_indices, local_energy
            )
            predicted_stress = predicted_stress.index_copy(
                0, local_indices, local_stress
            )

    pred_energy_np = predicted_energy.detach().cpu().numpy()
    pred_stress_np = predicted_stress.detach().cpu().numpy()
    true_energy_np = energy_np[test_indices]
    true_stress_np = stress_np[test_indices]
    energy_error = pred_energy_np - true_energy_np
    stress_error = pred_stress_np - true_stress_np
    if not np.all(np.isfinite(pred_energy_np)) or not np.all(np.isfinite(pred_stress_np)):
        raise FloatingPointError("model produced nonfinite test predictions")

    normalization = checkpoint["normalization"]
    energy_scale = float(normalization["energy_scale"])
    stress_scale = float(normalization["stress_scale"])
    overall = _error_metrics(
        energy_error, stress_error, test_ids, energy_scale, stress_scale
    )
    by_volume_fraction = {}
    for vf_value in np.unique(test_vf):
        local = np.flatnonzero(test_vf == vf_value)
        by_volume_fraction[f"{vf_value:.12g}"] = _error_metrics(
            energy_error[local],
            stress_error[local],
            test_ids[local],
            energy_scale,
            stress_scale,
        )

    report = {
        "status": "complete",
        "evaluated_split": "test",
        "test_set_was_used_for_model_selection": False,
        "independent_evaluation": dataset_is_independent,
        "training_dataset_sha256": training_dataset_sha256,
        "dataset_sha256": dataset_sha256,
        "evaluation_manifest_configuration_sha256": manifest.get(
            "configuration_sha256"
        ),
        "evaluation_config": manifest.get("config"),
        "checkpoint_sha256": _sha256_file(checkpoint_path),
        "checkpoint_best_epoch": int(checkpoint["best_epoch"]),
        "training_scales": {
            "energy_rms": energy_scale,
            "stress_rms": stress_scale,
        },
        "overall": overall,
        "by_volume_fraction": by_volume_fraction,
    }
    _atomic_json(report_path, report)

    csv_path = Path(csv_path)
    csv_path.parent.mkdir(parents=True, exist_ok=True)
    columns = [
        "sample_id",
        "state_index",
        "volume_fraction",
        "det_F",
        "energy_true",
        "energy_predicted",
        "energy_error",
        "energy_abs_error_train_scale",
        "stress_component_rmse",
        "stress_component_rmse_train_scale",
        "stress_frobenius_error_train_scale",
    ]
    with csv_path.open("w", newline="", encoding="utf-8") as output:
        writer = csv.DictWriter(output, fieldnames=columns)
        writer.writeheader()
        for i, dataset_index in enumerate(test_indices):
            stress_scaled = stress_error[i] / stress_scale
            writer.writerow(
                {
                    "sample_id": test_ids[i],
                    "state_index": int(data["state_index"][dataset_index]),
                    "volume_fraction": float(test_vf[i]),
                    "det_F": float(np.linalg.det(F_np[dataset_index])),
                    "energy_true": float(true_energy_np[i]),
                    "energy_predicted": float(pred_energy_np[i]),
                    "energy_error": float(energy_error[i]),
                    "energy_abs_error_train_scale": float(
                        abs(energy_error[i]) / energy_scale
                    ),
                    "stress_component_rmse": float(
                        np.sqrt(np.mean(stress_error[i] ** 2))
                    ),
                    "stress_component_rmse_train_scale": float(
                        np.sqrt(np.mean(stress_scaled**2))
                    ),
                    "stress_frobenius_error_train_scale": float(
                        np.linalg.norm(stress_scaled)
                    ),
                }
            )

    print(f"Evaluated {len(test_indices)} held-out test samples")
    print(f"Overall test metrics: {json.dumps(overall, sort_keys=True)}")
    print(f"Metrics by volume fraction: {json.dumps(by_volume_fraction, sort_keys=True)}")
    print(f"Report: {report_path}")
    print(f"Per-sample CSV: {csv_path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dataset", type=Path, required=True)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--checkpoint", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    parser.add_argument("--csv", type=Path, required=True)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--torch-threads", type=int, default=1)
    parser.add_argument(
        "--allow-independent-dataset",
        action="store_true",
        help="evaluate the checkpoint on a different, explicitly selected dataset",
    )
    args = parser.parse_args()
    evaluate_test_set(
        dataset_path=args.dataset,
        manifest_path=args.manifest,
        checkpoint_path=args.checkpoint,
        report_path=args.report,
        csv_path=args.csv,
        device=args.device,
        torch_threads=args.torch_threads,
        allow_independent_dataset=args.allow_independent_dataset,
    )


if __name__ == "__main__":
    main()
