"""Coupled periodic mixed-matrix and rigid-particle RVE solver."""
import numpy as np
from ngsolve import (
    BilinearForm,
    CF,
    Det,
    ET,
    Grad,
    GridFunction,
    Id,
    IntegrationRule,
    InnerProduct,
    Inv,
    Norm,
    Projector,
    Trace,
    dx,
    x,
    y,
    z,
)

from .mixed_matrix import make_mixed_space
from .rve import PARTICLE_BOUNDARY


def _matrix_stress(deformation_gradient, pressure, mu):
    jacobian = Det(deformation_gradient)
    first_invariant = Trace(
        deformation_gradient.trans * deformation_gradient
    )
    inverse_transpose = Inv(deformation_gradient).trans
    isochoric_stress = (
        mu
        * jacobian ** (-2.0 / 3.0)
        * (
            deformation_gradient
            - (first_invariant / 3.0) * inverse_transpose
        )
    )
    return isochoric_stress + pressure * jacobian * inverse_transpose


def _rve_residual_form(
    fes,
    macro_gradient,
    mu,
    bulk_modulus,
    integration_order=10,
):
    (fluctuation, pressure), (test_fluctuation, test_pressure) = (
        fes.TrialFunction(),
        fes.TestFunction(),
    )
    deformation_gradient = macro_gradient + Grad(fluctuation)
    jacobian = Det(deformation_gradient)
    stress = _matrix_stress(deformation_gradient, pressure, mu)
    measure = dx(intrules={
        ET.TET: IntegrationRule(ET.TET, order=integration_order),
    })

    residual = BilinearForm(fes)
    residual += (
        InnerProduct(stress, Grad(test_fluctuation))
        + test_pressure
        * (jacobian - 1.0 - pressure / bulk_modulus)
    ) * measure
    return residual


def solve_periodic_rigid_particle(
    mesh,
    macro_gradient,
    particle_displacement=None,
    mu=1.0,
    bulk_modulus=1.0e4,
    displacement_order=2,
    tol=1.0e-10,
    maxit=20,
    verbose=True,
    integration_order=10,
):
    """Solve one periodic RVE load state with an exactly rigid particle.

    The unknown displacement is the periodic fluctuation ``w`` and the total
    deformation gradient is ``macro_gradient + Grad(w)``.  The default particle
    motion is zero.  P2-V4 supplies the symmetry-preserving translation of the
    particle center under hydrostatic macroscopic loading, then independently
    verifies its net force and moment.
    """
    if particle_displacement is None:
        particle_displacement = CF((0.0, 0.0, 0.0))

    fes = make_mixed_space(
        mesh,
        displacement_order=displacement_order,
        periodic=True,
        dirichlet=PARTICLE_BOUNDARY,
    )
    solution = GridFunction(fes)

    reference_position = CF((x, y, z))
    macro_displacement = (macro_gradient - Id(3)) * reference_position
    particle_fluctuation = particle_displacement - macro_displacement
    solution.components[0].Set(
        particle_fluctuation,
        definedon=mesh.Boundaries(PARTICLE_BOUNDARY),
    )

    nonlinear_form = _rve_residual_form(
        fes,
        macro_gradient=macro_gradient,
        mu=mu,
        bulk_modulus=bulk_modulus,
        integration_order=integration_order,
    )
    free_projector = Projector(fes.FreeDofs(), True)
    residual = solution.vec.CreateVector()
    history = []
    for iteration in range(maxit):
        nonlinear_form.Apply(solution.vec, residual)
        residual.data = free_projector * residual
        residual_norm = Norm(residual)
        if not np.isfinite(residual_norm):
            raise FloatingPointError(
                f"Non-finite Newton residual at iteration {iteration}: "
                f"{residual_norm}"
            )
        history.append(residual_norm)
        if verbose:
            print(f"RVE Newton {iteration:2d}: |R| = {residual_norm:.3e}")
        if residual_norm < tol:
            break

        nonlinear_form.AssembleLinearization(solution.vec)
        try:
            inverse = nonlinear_form.mat.Inverse(
                fes.FreeDofs(),
                inverse="umfpack",
            )
            update = inverse * residual
        except Exception as exc:
            print(
                f"[NEWTON FACTORIZATION FAILURE] "
                f"iteration={iteration}, "
                f"residual_norm={residual_norm:.6e}, "
                f"macro_gradient_type={type(macro_gradient).__name__}, "
                f"error={type(exc).__name__}: {exc}",
                flush=True,
            )
            raise
        solution.vec.data -= update

    fluctuation, pressure = solution.components
    deformation_gradient = macro_gradient + Grad(fluctuation)
    stress = _matrix_stress(
        deformation_gradient,
        pressure,
        mu,
    )
    return solution, history, deformation_gradient, stress
