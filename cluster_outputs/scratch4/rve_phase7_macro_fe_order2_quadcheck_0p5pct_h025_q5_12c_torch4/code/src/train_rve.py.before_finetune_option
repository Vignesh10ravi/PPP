"""Train the context-conditioned pICNN on a verified homogenized RVE dataset.

Normalization statistics are fitted from the training split only. The saved
checkpoint includes these statistics, split membership, and dataset hashes.
This is intended for pilot pipeline validation; 300 samples are not a final
coverage set for a production constitutive surrogate.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path

import numpy as np
import torch
from torch.func import hessian, jacrev, vmap

from .picnn import HyperelasticNN, invariant_features


def _sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _atomic_json(path, payload):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(
        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)


def _load_rve_dataset(dataset_path, manifest_path):
    dataset_path = Path(dataset_path)
    manifest_path = Path(manifest_path)
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    dataset_hash = _sha256_file(dataset_path)
    if manifest.get("dataset_sha256") != dataset_hash:
        raise ValueError("dataset SHA-256 does not match its manifest")

    with np.load(dataset_path, allow_pickle=False) as archive:
        required = (
            "sample_id",
            "split",
            "state_index",
            "volume_fraction",
            "deformation_gradient",
            "energy",
            "stress",
            "tangent",
        )
        missing = set(required).difference(archive.files)
        if missing:
            raise ValueError(f"dataset is missing fields: {sorted(missing)}")
        data = {name: np.array(archive[name]) for name in required}

    ids = data["sample_id"].astype(str)
    splits = data["split"].astype(str)
    states = np.asarray(data["state_index"], dtype=int)
    if len(set(ids.tolist())) != len(ids):
        raise ValueError("sample IDs are not unique")

    # The generator assigns one split per deformation state and repeats that
    # state at each volume fraction. This guards against cross-VF leakage.
    for state_index in np.unique(states):
        members = np.flatnonzero(states == state_index)
        state_splits = np.unique(splits[members])
        if len(state_splits) != 1:
            raise ValueError(
                f"deformation state {state_index} appears in multiple splits: "
                f"{state_splits.tolist()}"
            )
        state_gradients = np.asarray(data["deformation_gradient"])[members]
        if not np.allclose(
            state_gradients,
            state_gradients[0],
            rtol=0.0,
            atol=1.0e-12,
        ):
            raise ValueError(
                f"deformation state {state_index} differs across volume fractions"
            )

    if not set(splits).issubset({"train", "validation", "test"}):
        raise ValueError(f"unknown split labels: {sorted(set(splits))}")
    if any(not np.any(splits == name) for name in ("train", "validation", "test")):
        raise ValueError("train, validation, and test splits must all be nonempty")

    arrays = {
        "sample_id": ids,
        "split": splits,
        "state_index": states,
        "volume_fraction": np.asarray(data["volume_fraction"], dtype=float),
        "deformation_gradient": np.asarray(data["deformation_gradient"], dtype=float),
        "energy": np.asarray(data["energy"], dtype=float).reshape(-1),
        "stress": np.asarray(data["stress"], dtype=float),
        "tangent": np.asarray(data["tangent"], dtype=float),
    }
    expected_n = int(manifest.get("n_samples", -1))
    if len(ids) != expected_n:
        raise ValueError(f"manifest expects {expected_n} samples, found {len(ids)}")
    if arrays["deformation_gradient"].shape != (len(ids), 3, 3):
        raise ValueError("deformation_gradient must have shape (N, 3, 3)")
    if arrays["stress"].shape != (len(ids), 3, 3):
        raise ValueError("stress must have shape (N, 3, 3)")
    if arrays["tangent"].shape != (len(ids), 9, 9):
        raise ValueError("tangent must have shape (N, 9, 9)")
    if not all(
        np.all(np.isfinite(value))
        for value in arrays.values()
        if np.issubdtype(np.asarray(value).dtype, np.number)
    ):
        raise ValueError("dataset contains nonfinite numerical values")
    return arrays, manifest, dataset_hash


def _grouped_energy_stress(model, gradients, contexts):
    """Predict energy and stress, sharing reference normalization per VF."""
    energy_prediction = torch.zeros(
        len(gradients), dtype=gradients.dtype, device=gradients.device
    )
    stress_prediction = torch.zeros_like(gradients)

    for context_value in torch.unique(contexts[:, 0]):
        indices = torch.nonzero(
            contexts[:, 0] == context_value, as_tuple=False
        ).flatten()
        group_gradients = gradients.index_select(0, indices)
        group_contexts = contexts.index_select(0, indices)
        reference_context = group_contexts[:1]
        reference = model.reference(
            gradients.dtype,
            gradients.device,
            reference_context,
        )
        group_energy = model.energy(
            group_gradients,
            group_contexts,
            ref=reference,
        )

        def energy_single(gradient):
            return model.energy(
                gradient.unsqueeze(0),
                reference_context,
                ref=reference,
            ).squeeze()

        group_stress = vmap(jacrev(energy_single))(group_gradients)
        energy_prediction = energy_prediction.index_copy(
            0, indices, group_energy.reshape(-1)
        )
        stress_prediction = stress_prediction.index_copy(
            0, indices, group_stress
        )
    return energy_prediction, stress_prediction


def _grouped_tangent(model, gradients, contexts):
    """Predict the energy Hessian with row-major deformation-gradient order."""
    tangent_prediction = torch.zeros(
        (len(gradients), 9, 9), dtype=gradients.dtype, device=gradients.device
    )
    for context_value in torch.unique(contexts[:, 0]):
        indices = torch.nonzero(
            contexts[:, 0] == context_value, as_tuple=False
        ).flatten()
        group_gradients = gradients.index_select(0, indices)
        group_contexts = contexts.index_select(0, indices)
        reference_context = group_contexts[:1]
        reference = model.reference(
            gradients.dtype,
            gradients.device,
            reference_context,
        )

        def energy_flat(flat_gradient):
            gradient = flat_gradient.reshape(3, 3)
            return model.energy(
                gradient.unsqueeze(0),
                reference_context,
                ref=reference,
            ).squeeze()

        group_tangent = vmap(hessian(energy_flat))(group_gradients.reshape(-1, 9))
        tangent_prediction = tangent_prediction.index_copy(
            0, indices, group_tangent
        )
    return tangent_prediction


def _relative_tangent_loss(predicted_tangent, target_tangent):
    """Mean squared per-sample relative Frobenius error of the tangent."""
    error_norm = torch.linalg.vector_norm(
        predicted_tangent - target_tangent, dim=(-2, -1)
    )
    target_norm = torch.linalg.vector_norm(target_tangent, dim=(-2, -1))
    relative_error = error_norm / target_norm.clamp_min(1.0e-12)
    return torch.mean(relative_error**2)


def _sample_tangent_indices(train_indices, determinants, batch_size):
    """Sample tangent targets evenly from compressed and remaining states."""
    compressed = train_indices[determinants[train_indices] < 0.70]
    remaining = train_indices[determinants[train_indices] >= 0.70]
    n_compressed = min(batch_size // 2, len(compressed))
    n_remaining = min(batch_size - n_compressed, len(remaining))
    selected = []
    if n_compressed:
        selected.extend(
            np.random.choice(compressed, size=n_compressed, replace=False).tolist()
        )
    if n_remaining:
        selected.extend(
            np.random.choice(remaining, size=n_remaining, replace=False).tolist()
        )
    if len(selected) < batch_size:
        available = np.setdiff1d(train_indices, np.asarray(selected, dtype=int))
        selected.extend(
            np.random.choice(
                available,
                size=batch_size - len(selected),
                replace=False,
            ).tolist()
        )
    np.random.shuffle(selected)
    return np.asarray(selected, dtype=int)


def _select_tangent_validation_indices(
    validation_indices,
    state_indices,
    determinants,
    n_states,
    seed,
):
    """Choose whole validation deformation groups, including compressed states."""
    unique_states = np.unique(state_indices[validation_indices])
    representative = {
        state: int(
            validation_indices[
                np.flatnonzero(state_indices[validation_indices] == state)[0]
            ]
        )
        for state in unique_states
    }
    compressed_states = np.asarray(
        [state for state in unique_states if determinants[representative[state]] < 0.70],
        dtype=int,
    )
    other_states = np.asarray(
        [state for state in unique_states if determinants[representative[state]] >= 0.70],
        dtype=int,
    )
    rng = np.random.default_rng(seed + 1)
    n_compressed = min(n_states // 2, len(compressed_states))
    n_other = min(n_states - n_compressed, len(other_states))
    selected = []
    if n_compressed:
        selected.extend(
            rng.choice(compressed_states, size=n_compressed, replace=False).tolist()
        )
    if n_other:
        selected.extend(rng.choice(other_states, size=n_other, replace=False).tolist())
    if len(selected) < min(n_states, len(unique_states)):
        available = np.setdiff1d(unique_states, np.asarray(selected, dtype=int))
        selected.extend(
            rng.choice(
                available,
                size=min(n_states, len(unique_states)) - len(selected),
                replace=False,
            ).tolist()
        )
    selected = np.asarray(selected, dtype=int)
    return validation_indices[np.isin(state_indices[validation_indices], selected)]


def _loss_metrics(model, F, c, energy, stress, energy_scale, stress_scale, stress_weight):
    predicted_energy, predicted_stress = _grouped_energy_stress(model, F, c)
    energy_error = predicted_energy - energy
    stress_error = predicted_stress - stress
    energy_loss = torch.mean((energy_error / energy_scale) ** 2)
    stress_loss = torch.mean((stress_error / stress_scale) ** 2)
    total_loss = energy_loss + stress_weight * stress_loss
    metrics = {
        "loss": float(total_loss.detach().cpu()),
        "energy_loss_normalized": float(energy_loss.detach().cpu()),
        "stress_loss_normalized": float(stress_loss.detach().cpu()),
        "energy_rmse": float(torch.sqrt(torch.mean(energy_error.detach() ** 2)).cpu()),
        "stress_rmse": float(torch.sqrt(torch.mean(stress_error.detach() ** 2)).cpu()),
    }
    return total_loss, metrics


def train_rve(
    dataset_path,
    manifest_path,
    checkpoint_path,
    report_path,
    epochs=2000,
    batch_size=64,
    learning_rate=1.0e-3,
    stress_weight=1.0,
    patience=30,
    validation_interval=10,
    seed=1729,
    device="cpu",
    torch_threads=1,
    tangent_weight=0.0,
    tangent_batch_size=8,
    tangent_validation_states=8,
):
    if tangent_weight < 0.0:
        raise ValueError("tangent_weight cannot be negative")
    if tangent_batch_size < 1:
        raise ValueError("tangent_batch_size must be at least one")
    if tangent_validation_states < 1:
        raise ValueError("tangent_validation_states must be at least one")
    torch.manual_seed(seed)
    np.random.seed(seed)
    torch.set_num_threads(torch_threads)
    torch.set_num_interop_threads(1)
    arrays, manifest, dataset_hash = _load_rve_dataset(dataset_path, manifest_path)

    device = torch.device(device)
    dtype = torch.float64
    F_all = torch.as_tensor(arrays["deformation_gradient"], dtype=dtype, device=device)
    vf_all = torch.as_tensor(
        arrays["volume_fraction"].reshape(-1, 1), dtype=dtype, device=device
    )
    energy_all = torch.as_tensor(arrays["energy"], dtype=dtype, device=device)
    stress_all = torch.as_tensor(arrays["stress"], dtype=dtype, device=device)
    tangent_all = torch.as_tensor(arrays["tangent"], dtype=dtype, device=device)
    split = arrays["split"]
    train_indices = np.flatnonzero(split == "train")
    validation_indices = np.flatnonzero(split == "validation")
    test_indices = np.flatnonzero(split == "test")
    train_index_tensor = torch.as_tensor(train_indices, dtype=torch.long, device=device)

    train_features = invariant_features(F_all.index_select(0, train_index_tensor))
    feature_mean = train_features.mean(dim=0)
    feature_scale = train_features.std(dim=0, unbiased=False).clamp_min(1.0e-8)
    train_context = vf_all.index_select(0, train_index_tensor)
    context_mean = train_context.mean(dim=0)
    context_scale = train_context.std(dim=0, unbiased=False).clamp_min(1.0e-8)
    energy_scale = torch.sqrt(
        torch.mean(energy_all.index_select(0, train_index_tensor) ** 2)
    ).clamp_min(1.0e-8)
    stress_scale = torch.sqrt(
        torch.mean(stress_all.index_select(0, train_index_tensor) ** 2)
    ).clamp_min(1.0e-8)
    tangent_component_rms_scale = torch.sqrt(
        torch.mean(tangent_all.index_select(0, train_index_tensor) ** 2)
    ).clamp_min(1.0e-8)
    determinants = np.linalg.det(arrays["deformation_gradient"])
    validation_tangent_indices = _select_tangent_validation_indices(
        validation_indices,
        arrays["state_index"],
        determinants,
        tangent_validation_states,
        seed,
    )

    model = HyperelasticNN(n_ctx=1).to(device=device, dtype=dtype)
    model.set_normalization(
        feature_mean,
        feature_scale,
        context_mean,
        context_scale,
    )
    optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)

    normalization = {
        "feature_mean": feature_mean.detach().cpu().tolist(),
        "feature_scale": feature_scale.detach().cpu().tolist(),
        "context_mean": context_mean.detach().cpu().tolist(),
        "context_scale": context_scale.detach().cpu().tolist(),
        "energy_scale": float(energy_scale.detach().cpu()),
        "stress_scale": float(stress_scale.detach().cpu()),
        "tangent_component_rms_scale": float(
            tangent_component_rms_scale.detach().cpu()
        ),
        "fit_split": "train",
    }
    config = {
        "epochs": int(epochs),
        "batch_size": int(batch_size),
        "learning_rate": float(learning_rate),
        "stress_weight": float(stress_weight),
        "tangent_weight": float(tangent_weight),
        "tangent_batch_size": int(tangent_batch_size),
        "tangent_validation_states": int(tangent_validation_states),
        "tangent_sampling": "half detF<0.70, half detF>=0.70 when available",
        "tangent_loss": "mean squared per-sample relative Frobenius error",
        "patience_validation_checks": int(patience),
        "validation_interval": int(validation_interval),
        "seed": int(seed),
        "device": str(device),
        "model": "HyperelasticNN(n_ctx=1), invariant-feature pICNN",
        "reference_normalization": (
            "objective pressure correction using trace(P_raw(I))/3 times (det(F)-1)"
        ),
        "model_symmetry_assumption": "isotropic in F, conditioned on volume fraction",
    }
    checkpoint_path = Path(checkpoint_path)
    checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
    report_path = Path(report_path)
    report_path.parent.mkdir(parents=True, exist_ok=True)
    history = []
    best_validation_loss = float("inf")
    best_epoch = 0
    stale_checks = 0

    def select(indices):
        index_tensor = torch.as_tensor(indices, dtype=torch.long, device=device)
        return (
            F_all.index_select(0, index_tensor),
            vf_all.index_select(0, index_tensor),
            energy_all.index_select(0, index_tensor),
            stress_all.index_select(0, index_tensor),
        )

    val_data = select(validation_indices)
    val_tangent_index_tensor = torch.as_tensor(
        validation_tangent_indices, dtype=torch.long, device=device
    )
    val_tangent_data = (
        F_all.index_select(0, val_tangent_index_tensor),
        vf_all.index_select(0, val_tangent_index_tensor),
        tangent_all.index_select(0, val_tangent_index_tensor),
    )
    train_count = len(train_indices)
    if train_count == 0 or len(validation_indices) == 0 or len(test_indices) == 0:
        raise ValueError("train, validation, and test splits must be nonempty")

    for epoch in range(1, epochs + 1):
        model.train()
        permutation = torch.randperm(train_count, device=device)
        batch_loss_sum = 0.0
        batch_count = 0
        for start in range(0, train_count, batch_size):
            chosen = train_index_tensor.index_select(
                0, permutation[start : start + batch_size]
            )
            F_batch = F_all.index_select(0, chosen)
            c_batch = vf_all.index_select(0, chosen)
            energy_batch = energy_all.index_select(0, chosen)
            stress_batch = stress_all.index_select(0, chosen)

            optimizer.zero_grad(set_to_none=True)
            loss, _ = _loss_metrics(
                model,
                F_batch,
                c_batch,
                energy_batch,
                stress_batch,
                energy_scale,
                stress_scale,
                stress_weight,
            )
            loss.backward()
            optimizer.step()
            batch_loss_sum += float(loss.detach().cpu())
            batch_count += 1

        tangent_loss_value = 0.0
        if tangent_weight > 0.0:
            tangent_indices = _sample_tangent_indices(
                train_indices,
                determinants,
                min(tangent_batch_size, train_count),
            )
            tangent_index_tensor = torch.as_tensor(
                tangent_indices, dtype=torch.long, device=device
            )
            F_tangent = F_all.index_select(0, tangent_index_tensor)
            c_tangent = vf_all.index_select(0, tangent_index_tensor)
            target_tangent = tangent_all.index_select(0, tangent_index_tensor)

            optimizer.zero_grad(set_to_none=True)
            predicted_tangent = _grouped_tangent(model, F_tangent, c_tangent)
            tangent_loss = _relative_tangent_loss(
                predicted_tangent, target_tangent
            )
            (tangent_weight * tangent_loss).backward()
            optimizer.step()
            tangent_loss_value = float(tangent_loss.detach().cpu())

        if epoch % validation_interval != 0 and epoch != epochs:
            continue

        model.eval()
        with torch.enable_grad():
            _, validation_metrics = _loss_metrics(
                model,
                *val_data,
                energy_scale,
                stress_scale,
                stress_weight,
            )
            if tangent_weight > 0.0:
                val_F_tangent, val_context_tangent, val_target_tangent = (
                    val_tangent_data
                )
                val_predicted_tangent = _grouped_tangent(
                    model,
                    val_F_tangent,
                    val_context_tangent,
                )
                val_tangent_loss = _relative_tangent_loss(
                    val_predicted_tangent, val_target_tangent
                )
                validation_metrics["tangent_relative_frobenius_mse"] = float(
                    val_tangent_loss.detach().cpu()
                )
                validation_metrics["tangent_relative_frobenius_rmse"] = float(
                    torch.sqrt(val_tangent_loss.detach()).cpu()
                )
                validation_metrics["selection_loss"] = float(
                    validation_metrics["loss"]
                    + tangent_weight
                    * validation_metrics["tangent_relative_frobenius_mse"]
                )
            else:
                validation_metrics["selection_loss"] = validation_metrics["loss"]
        selection_loss = validation_metrics["selection_loss"]
        row = {
            "epoch": epoch,
            "train_loss_mean": batch_loss_sum / max(1, batch_count),
            "train_tangent_relative_frobenius_mse": tangent_loss_value,
            "train_objective_estimate": (
                batch_loss_sum / max(1, batch_count)
                + tangent_weight * tangent_loss_value
            ),
            "validation": validation_metrics,
        }
        history.append(row)
        print(
            f"epoch={epoch} train_loss={row['train_loss_mean']:.6e} "
            f"validation_loss={validation_metrics['loss']:.6e} "
            f"selection_loss={selection_loss:.6e} "
            f"tangent_rel_frob_mse={tangent_loss_value:.6e} "
            f"energy_rmse={validation_metrics['energy_rmse']:.6e} "
            f"stress_rmse={validation_metrics['stress_rmse']:.6e}",
            flush=True,
        )

        if selection_loss < best_validation_loss:
            best_validation_loss = selection_loss
            best_epoch = epoch
            stale_checks = 0
            payload = {
                "state_dict": model.state_dict(),
                "optimizer_state_dict": optimizer.state_dict(),
                "normalization": normalization,
                "training_config": config,
                "dataset_sha256": dataset_hash,
                "manifest_configuration_sha256": manifest.get(
                    "configuration_sha256"
                ),
                "best_epoch": best_epoch,
                "best_validation": validation_metrics,
                "history": history,
            }
            temporary_checkpoint = checkpoint_path.with_name(
                f".{checkpoint_path.name}.tmp"
            )
            torch.save(payload, temporary_checkpoint)
            os.replace(temporary_checkpoint, checkpoint_path)
        else:
            stale_checks += 1
            if stale_checks >= patience:
                print(f"Early stopping at epoch {epoch}", flush=True)
                break

        _atomic_json(
            report_path,
            {
                "status": "training",
                "dataset_sha256": dataset_hash,
                "manifest_configuration_sha256": manifest.get(
                    "configuration_sha256"
                ),
                "training_config": config,
                "normalization": normalization,
                "split_counts": {
                    name: int(np.count_nonzero(split == name))
                    for name in ("train", "validation", "test")
                },
                "history": history,
                "best_epoch": best_epoch,
            },
        )

    if not checkpoint_path.exists():
        raise RuntimeError("training did not produce a best-validation checkpoint")
    best = torch.load(checkpoint_path, map_location=device, weights_only=True)
    model.load_state_dict(best["state_dict"])
    model.eval()
    test_data = select(test_indices)
    with torch.enable_grad():
        _, test_metrics = _loss_metrics(
            model,
            *test_data,
            energy_scale,
            stress_scale,
            stress_weight,
        )

    final_report = {
        "status": "complete",
        "dataset_path": str(Path(dataset_path).resolve()),
        "dataset_sha256": dataset_hash,
        "manifest_path": str(Path(manifest_path).resolve()),
        "manifest_configuration_sha256": manifest.get("configuration_sha256"),
        "training_config": config,
        "normalization": normalization,
        "split_counts": {
            name: int(np.count_nonzero(split == name))
            for name in ("train", "validation", "test")
        },
        "split_deformation_state_counts": {
            name: int(
                len(np.unique(arrays["state_index"][split == name]))
            )
            for name in ("train", "validation", "test")
        },
        "best_epoch": int(best["best_epoch"]),
        "best_validation": best["best_validation"],
        "test_metrics": test_metrics,
        "history": best["history"],
        "checkpoint_path": str(checkpoint_path.resolve()),
        "split_scope_note": (
            "Samples are grouped by deformation state across volume fractions. "
            "If this test split informs model selection, reserve new grouped "
            "deformation states for the final independent evaluation."
        ),
    }
    _atomic_json(report_path, final_report)
    print(f"Best epoch: {best['best_epoch']}", flush=True)
    print(f"Test metrics: {test_metrics}", flush=True)
    print(f"Checkpoint: {checkpoint_path}", flush=True)
    print(f"Training report: {report_path}", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dataset", required=True)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--report", required=True)
    parser.add_argument("--epochs", type=int, default=2000)
    parser.add_argument("--batch-size", type=int, default=64)
