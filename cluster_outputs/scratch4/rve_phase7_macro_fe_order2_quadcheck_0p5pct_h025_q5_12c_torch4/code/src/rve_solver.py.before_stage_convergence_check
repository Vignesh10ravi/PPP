"""Coupled periodic mixed-matrix and rigid-particle RVE solver."""
import numpy as np
from ngsolve import (
    BilinearForm,
    CF,
    Det,
    ET,
    Grad,
    GridFunction,
    IfPos,
    Id,
    IntegrationRule,
    InnerProduct,
    Integrate,
    Inv,
    Norm,
    Projector,
    Trace,
    dx,
    x,
    y,
    z,
)

from .mixed_matrix import make_mixed_space
from .rve import PARTICLE_BOUNDARY


def _matrix_stress(deformation_gradient, pressure, mu):
    jacobian = Det(deformation_gradient)
    first_invariant = Trace(
        deformation_gradient.trans * deformation_gradient
    )
    inverse_transpose = Inv(deformation_gradient).trans
    isochoric_stress = (
        mu
        * jacobian ** (-2.0 / 3.0)
        * (
            deformation_gradient
            - (first_invariant / 3.0) * inverse_transpose
        )
    )
    return isochoric_stress + pressure * jacobian * inverse_transpose


def _rve_residual_form(
    fes,
    macro_gradient,
    mu,
    bulk_modulus,
    integration_order=10,
):
    (fluctuation, pressure), (test_fluctuation, test_pressure) = (
        fes.TrialFunction(),
        fes.TestFunction(),
    )

    deformation_gradient = macro_gradient + Grad(fluctuation)
    jacobian = Det(deformation_gradient)

    measure = dx(intrules={
        ET.TET: IntegrationRule(ET.TET, order=integration_order),
    })

    stress = _matrix_stress(deformation_gradient, pressure, mu)

    residual = BilinearForm(fes)
    residual += (
        InnerProduct(stress, Grad(test_fluctuation))
        + test_pressure
        * (jacobian - 1.0 - pressure / bulk_modulus)
    ) * measure

    return residual


def solve_periodic_rigid_particle(
    mesh,
    macro_gradient,
    particle_displacement=None,
    mu=1.0,
    bulk_modulus=1.0e4,
    displacement_order=2,
    tol=1.0e-10,
    maxit=20,
    verbose=True,
    integration_order=10,
    initial_solution=None,
):
    """Solve one periodic RVE load state with an exactly rigid particle.

    The unknown displacement is the periodic fluctuation ``w`` and the total
    deformation gradient is ``macro_gradient + Grad(w)``.  The default particle
    motion is zero.  P2-V4 supplies the symmetry-preserving translation of the
    particle center under hydrostatic macroscopic loading, then independently
    verifies its net force and moment.
    """
    if particle_displacement is None:
        particle_displacement = CF((0.0, 0.0, 0.0))

    fes = make_mixed_space(
        mesh,
        displacement_order=displacement_order,
        periodic=True,
        dirichlet=PARTICLE_BOUNDARY,
    )
    solution = GridFunction(fes)

    reference_position = CF((x, y, z))
    macro_displacement = (macro_gradient - Id(3)) * reference_position
    particle_fluctuation = particle_displacement - macro_displacement
    if initial_solution is None:
        # Construct a periodic harmonic extension of the prescribed particle
        # boundary fluctuation instead of leaving the interior DOFs at zero.
        displacement_space = fes.components[0]
        initial_displacement = GridFunction(displacement_space)
        initial_displacement.Set(
            particle_fluctuation,
            definedon=mesh.Boundaries(PARTICLE_BOUNDARY),
        )

        # Minimize the displacement-gradient energy over the unconstrained
        # displacement DOFs, retaining periodicity and particle-boundary values.
        initial_trial, initial_test = (
            displacement_space.TrialFunction(),
            displacement_space.TestFunction(),
        )

        extension_form = BilinearForm(displacement_space)
        extension_form += InnerProduct(
            Grad(initial_trial),
            Grad(initial_test),
        ) * dx
        extension_form.Assemble()

        extension_residual = (
            -extension_form.mat * initial_displacement.vec
        )

        extension_update = extension_form.mat.Inverse(
            displacement_space.FreeDofs(),
            inverse="umfpack",
        ) * extension_residual

        initial_displacement.vec.data += extension_update

        # Transfer the extended displacement into the mixed displacement-pressure
        # solution. The pressure field remains at its initial value.
        solution.components[0].vec.data = initial_displacement.vec
    else:
        # Continue from a previously equilibrated load step. Updating the
        # prescribed particle values by a small increment avoids restarting
        # from a potentially inverted harmonic extension at the full load.
        solution.vec.data = initial_solution.vec
        solution.components[0].Set(
            particle_fluctuation,
            definedon=mesh.Boundaries(PARTICLE_BOUNDARY),
        )

    nonlinear_form = _rve_residual_form(
        fes,
        macro_gradient=macro_gradient,
        mu=mu,
        bulk_modulus=bulk_modulus,
        integration_order=integration_order,
    )
    free_projector = Projector(fes.FreeDofs(), True)
    residual = solution.vec.CreateVector()
    history = []
    measure_check = dx(
        intrules={
            ET.TET: IntegrationRule(
                ET.TET,
                order=integration_order,
            )
        }
    )
    domain_measure = Integrate(CF(1.0) * measure_check, mesh)

    # Diagnostic: inspect the initial finite-element solution vector.
    solution_values = np.asarray(solution.vec.FV().NumPy(), dtype=float)
    print(
        "[INITIAL STATE] "
        f"solution_size={solution_values.size}, "
        f"finite={np.all(np.isfinite(solution_values))}, "
        f"min={np.nanmin(solution_values):.6e}, "
        f"max={np.nanmax(solution_values):.6e}",
        flush=True,
    )
    for iteration in range(maxit):
        nonlinear_form.Apply(solution.vec, residual)

        raw_residual = np.asarray(residual.FV().NumPy(), dtype=float)

        print(
            "[RESIDUAL BEFORE PROJECTION] "
            f"finite={np.all(np.isfinite(raw_residual))}, "
            f"nan_count={np.count_nonzero(np.isnan(raw_residual))}, "
            f"inf_count={np.count_nonzero(np.isinf(raw_residual))}",
            flush=True,
        )

        residual.data = free_projector * residual

        projected_residual = np.asarray(residual.FV().NumPy(), dtype=float)

        print(
            "[RESIDUAL AFTER PROJECTION] "
            f"finite={np.all(np.isfinite(projected_residual))}, "
            f"nan_count={np.count_nonzero(np.isnan(projected_residual))}, "
            f"inf_count={np.count_nonzero(np.isinf(projected_residual))}",
            flush=True,
        )

        residual_norm = Norm(residual)
        if not np.isfinite(residual_norm):
            raise FloatingPointError(
                f"Non-finite Newton residual at iteration {iteration}: "
                f"{residual_norm}"
            )
        history.append(residual_norm)
        if verbose:
            print(f"RVE Newton {iteration:2d}: |R| = {residual_norm:.3e}")
        if residual_norm < tol:
            break

        nonlinear_form.AssembleLinearization(solution.vec)
        try:
            inverse = nonlinear_form.mat.Inverse(
                fes.FreeDofs(),
                inverse="umfpack",
            )
            update = inverse * residual
        except Exception as exc:
            print(
                f"[NEWTON FACTORIZATION FAILURE] "
                f"iteration={iteration}, "
                f"residual_norm={residual_norm:.6e}, "
                f"macro_gradient_type={type(macro_gradient).__name__}, "
                f"error={type(exc).__name__}: {exc}",
                flush=True,
            )
            raise
        # Diagnostic: inspect the full Newton update before damping it.
        update_vector = solution.vec.CreateVector()
        update_vector.data = update
        update_values = np.asarray(update_vector.FV().NumPy(), dtype=float)
        print(
            "[NEWTON UPDATE] "
            f"iteration={iteration}, "
            f"finite={np.all(np.isfinite(update_values))}, "
            f"norm={Norm(update):.6e}, "
            f"max_abs={np.max(np.abs(update_values)):.6e}",
            flush=True,
        )
        base_solution = solution.vec.CreateVector()
        base_solution.data = solution.vec
        trial_residual = solution.vec.CreateVector()
        accepted = False
        step_length = 1.0
        positive_measure = 0.0
        inadmissible_measure = float("inf")
        trial_residual_norm = float("inf")

        for line_search_iteration in range(24):
            solution.vec.data = base_solution
            solution.vec.data -= step_length * update

            fluctuation_check = solution.components[0]
            jacobian_check = Det(
                macro_gradient + Grad(fluctuation_check)
            )
            inadmissible_measure = Integrate(
                IfPos(jacobian_check - 1.0e-8, 0.0, 1.0)
                * measure_check,
                mesh,
            )
            positive_measure = domain_measure - inadmissible_measure

            if (
                np.isfinite(inadmissible_measure)
                and inadmissible_measure <= 1.0e-14
            ):
                nonlinear_form.Apply(solution.vec, trial_residual)
                trial_residual_values = np.asarray(
                    trial_residual.FV().NumPy(),
                    dtype=float,
                )
                if np.all(np.isfinite(trial_residual_values)):
                    trial_residual.data = free_projector * trial_residual
                    trial_residual_norm = Norm(trial_residual)
                    sufficient_decrease = (
                        trial_residual_norm <= tol
                        or trial_residual_norm
                        < residual_norm * (1.0 - 1.0e-4 * step_length)
                    )
                    if np.isfinite(trial_residual_norm) and sufficient_decrease:
                        accepted = True
                        break

            solution.vec.data = base_solution
            step_length *= 0.5

        if not accepted:
            solution.vec.data = base_solution
            raise RuntimeError(
                "Newton line search could not find a finite, "
                "orientation-preserving residual-decreasing step "
                f"at iteration {iteration}"
            )

        print(
            "[NEWTON LINE SEARCH] "
            f"iteration={iteration}, "
            f"step_length={step_length:.6e}, "
            f"residual_norm={trial_residual_norm:.6e}, "
            f"positive_measure={float(positive_measure):.6e}, "
            f"inadmissible_measure={float(inadmissible_measure):.6e}, "
            f"backtracks={line_search_iteration}",
            flush=True,
        )

    fluctuation, pressure = solution.components
    deformation_gradient = macro_gradient + Grad(fluctuation)
    stress = _matrix_stress(
        deformation_gradient,
        pressure,
        mu,
    )
    return solution, history, deformation_gradient, stress
