"""Sobolev training of the pICNN against Neo-Hookean (energy + stress).

The stress term is weighted higher than the energy term because an accurate
tangent/stress is what drives Newton-Raphson convergence in the FE solver.

Usage:
    python -m src.train --epochs 1500 --ckpt checkpoints/phase1.pt
"""
import argparse
import torch

from .neohooke import make_dataset
from .picnn import HyperelasticNN
from .constitutive import stress


def train(epochs=1500, batch=512, lr=2e-3, lam_psi=1.0, lam_P=10.0,
          n_data=20000, device="cpu", seed=0, ckpt=None, verbose=True):
    torch.manual_seed(seed)
    F_tr, psi_tr, P_tr = make_dataset(n_data, device=device, seed=seed)
    model = HyperelasticNN().to(device).double()
    F_tr, psi_tr, P_tr = F_tr.double(), psi_tr.double(), P_tr.double()

    opt = torch.optim.Adam(model.parameters(), lr=lr)
    history = []
    for ep in range(epochs):
        idx = torch.randint(0, len(F_tr), (batch,), device=device)
        F = F_tr[idx].clone()
        P_hat = stress(model, F)
        psi_hat = model.energy(F)
        loss = (lam_psi * ((psi_hat - psi_tr[idx]) ** 2).mean()
                + lam_P * ((P_hat - P_tr[idx]) ** 2).mean())
        opt.zero_grad()
        loss.backward()
        opt.step()
        history.append(loss.item())
        if verbose and ep % 200 == 0:
            print(f"epoch {ep:5d}  loss {loss.item():.3e}")

    if ckpt:
        torch.save({"state_dict": model.state_dict(), "history": history}, ckpt)
        if verbose:
            print(f"saved -> {ckpt}")
    return model, history


def load_model(ckpt, device="cpu"):
    model = HyperelasticNN().to(device).double()
    model.load_state_dict(torch.load(ckpt, map_location=device)["state_dict"])
    model.eval()
    return model


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("--epochs", type=int, default=1500)
    p.add_argument("--batch", type=int, default=512)
    p.add_argument("--lr", type=float, default=2e-3)
    p.add_argument("--ckpt", type=str, default="checkpoints/phase1.pt")
    p.add_argument("--device", type=str, default="cpu")
    a = p.parse_args()
    import os
    os.makedirs(os.path.dirname(a.ckpt) or ".", exist_ok=True)
    train(epochs=a.epochs, batch=a.batch, lr=a.lr, device=a.device, ckpt=a.ckpt)
