#!/bin/bash
#PBS -N rve_p7_finetune
#PBS -q teachingq
#PBS -l select=1:ncpus=12:mem=64GB
#PBS -l walltime=24:00:00
#PBS -o /scratch/vr80beqo/rve_phase7_augmented_finetune12.out
#PBS -e /scratch/vr80beqo/rve_phase7_augmented_finetune12.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$SCRATCH/venvs/ppp-rve-train-cpu/bin/activate"

export OMP_NUM_THREADS=12
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=12
export PYTHONUNBUFFERED=1

PHASE6=/scratch/vr80beqo/rve_phase6_targeted_20261106
DATA_DIR=/scratch/vr80beqo/rve_phase7_augmented_training_20261109/data
INITIAL_CHECKPOINT="$PHASE6/data/training_objective_tangent/partial_icnn_phase6_targeted.pt"
TRAIN_DIR=/scratch/vr80beqo/rve_phase7_augmented_finetune12/training
mkdir -p "$TRAIN_DIR"

test -f "$DATA_DIR/rve_phase6_phase7_training.npz"
test -f "$DATA_DIR/rve_phase6_phase7_training.manifest.json"
test -f "$INITIAL_CHECKPOINT"

python -c 'import numpy, torch; print("NumPy", numpy.__version__, "PyTorch", torch.__version__)'
python -u -m src.train_rve \
  --dataset "$DATA_DIR/rve_phase6_phase7_training.npz" \
  --manifest "$DATA_DIR/rve_phase6_phase7_training.manifest.json" \
  --checkpoint "$TRAIN_DIR/partial_icnn_phase6_phase7_finetuned.pt" \
  --report "$TRAIN_DIR/training_report.json" \
  --initialize-from "$INITIAL_CHECKPOINT" \
  --epochs 3000 \
  --batch-size 64 \
  --learning-rate 1.0e-4 \
  --stress-weight 1.0 \
  --tangent-weight 0.10 \
  --tangent-batch-size 8 \
  --tangent-validation-states 12 \
  --patience 20 \
  --validation-interval 25 \
  --seed 4103 \
  --device cpu \
  --torch-threads 12 \
  2>&1 | tee "$TRAIN_DIR/training.log"
