#!/bin/bash
#PBS -N rve_phase6_eval
#PBS -q teachingq
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -l walltime=06:00:00
#PBS -o /scratch/vr80beqo/rve_phase6_targeted_evaluation.out
#PBS -e /scratch/vr80beqo/rve_phase6_targeted_evaluation.err

set -euo pipefail
cd "$HOME/PPP/Project implementation plan (2)" || exit 1

module load python/gcc/11.4.0/3.11.7
source "$SCRATCH/venvs/ppp-rve-train-cpu/bin/activate"

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=4

RUN_ROOT=/scratch/vr80beqo/rve_phase6_targeted_20261106
DATASET="$RUN_ROOT/data/rve_phase6_targeted.npz"
MANIFEST="$RUN_ROOT/data/rve_phase6_targeted.manifest.json"
TRAIN_DIR="$RUN_ROOT/data/training_objective_tangent"
CHECKPOINT="$TRAIN_DIR/partial_icnn_phase6_targeted.pt"
OUT_DIR="$TRAIN_DIR/evaluation"
mkdir -p "$OUT_DIR"

python -c 'import numpy, torch; print("NumPy", numpy.__version__, "PyTorch", torch.__version__)'
python - <<'PY'
import json
from pathlib import Path

report = Path("/scratch/vr80beqo/rve_phase6_targeted_20261106/data/training_objective_tangent/training_report.json")
status = json.loads(report.read_text(encoding="utf-8"))["status"]
if status != "complete":
    raise SystemExit(f"Training report status is {status!r}, expected 'complete'")
PY

python -u -m benchmarks.rve_test_set_evaluation \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --report "$OUT_DIR/energy_stress_report.json" \
  --csv "$OUT_DIR/energy_stress_predictions.csv" \
  --device cpu \
  --torch-threads 4 \
  --exclude-state-index 0 \
  2>&1 | tee "$OUT_DIR/energy_stress_evaluation.log"

python -u -m benchmarks.rve_surrogate_tangent_evaluation \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --training-dataset "$DATASET" \
  --report "$OUT_DIR/tangent_report.json" \
  --csv "$OUT_DIR/tangent_predictions.csv" \
  --device cpu \
  --torch-threads 4 \
  --split test \
  --exclude-state-index 0 \
  2>&1 | tee "$OUT_DIR/tangent_evaluation.log"

python -u -m benchmarks.rve_surrogate_constitutive_checks \
  --dataset "$DATASET" \
  --manifest "$MANIFEST" \
  --checkpoint "$CHECKPOINT" \
  --training-dataset "$DATASET" \
  --report "$OUT_DIR/constitutive_checks.json" \
  --states-per-det-bin 2 \
  --fd-step 1.0e-5 \
  --torch-threads 4 \
  2>&1 | tee "$OUT_DIR/constitutive_checks.log"
